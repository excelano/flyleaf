<?xml version="1.0" encoding="UTF-8"?>
<!--
  What a Store build is signed with. The App Sandbox is mandatory on the Mac
  App Store, and these two are the whole of what this application needs:
  `files.user-selected.read-write` is the grant a person gives by choosing a
  file in the open panel or a destination in the save panel. Nothing else is
  asked for. The save path had to change to live inside this much, and
  `flyleaf-core`'s `save_to` records it.

  The entitlement does nothing until it is inside a signature, which is why
  every sandbox measurement is made against a signed bundle; an Apple
  Development certificate is enough to make them.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
